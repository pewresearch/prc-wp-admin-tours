{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "prc-wp-admin-tours/splash-screen",
  "version": "1.0.0",
  "title": "Splash Screen",
  "category": "widgets",
  "description": "Author a wp-admin splash for this release. It does not appear on the public post.",
  "keywords": [
    "splash",
    "tour",
    "welcome",
    "release notes"
  ],
  "attributes": {
    "splashId": {
      "type": "string",
      "default": ""
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "showLogo": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "anchor": false,
    "align": false,
    "customClassName": false
  },
  "allowedBlocks": [
    "core/heading",
    "core/paragraph",
    "core/list",
    "core/image",
    "core/buttons"
  ],
  "textdomain": "prc-wp-admin-tours",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}